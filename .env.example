# Global / API environment variables
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://housie_user:housie_password@localhost:5432/housie_db?schema=public

# Redis 7
REDIS_URL=redis://localhost:6379

# JWT Secrets (generate 32+ byte random string in production)
JWT_SECRET=super-secret-jwt-signing-key-for-development-32chars
JWT_ACCESS_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Cookie settings
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Web environment variables
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
